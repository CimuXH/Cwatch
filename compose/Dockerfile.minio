ARG IMAGE_PREFIX
FROM ${IMAGE_PREFIX}golang:1.24.9-bookworm AS build
ARG GOPROXY=https://proxy.golang.org
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 GOMEMLIMIT=550MiB
WORKDIR /src
RUN curl -fsSL --retry 3 https://codeload.github.com/minio/minio/tar.gz/9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a -o /tmp/minio.tar.gz \
    && tar -xzf /tmp/minio.tar.gz --strip-components=1 \
    && rm /tmp/minio.tar.gz
RUN go build -p=1 -mod=readonly -trimpath \
    -ldflags="-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a" \
    -o /out/minio .
COPY compose/minio-init/main.go /tmp/cwatch-minio-init.go
RUN go build -p=1 -mod=readonly -trimpath -ldflags="-s -w" -o /out/cwatch-minio-init /tmp/cwatch-minio-init.go

FROM ${IMAGE_PREFIX}debian:bookworm-slim
RUN install -d -o 10002 -g 10002 -m 0750 /data
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/cwatch-minio-init /usr/local/bin/cwatch-minio-init
USER 10002:10002
ENTRYPOINT ["/usr/local/bin/minio"]
